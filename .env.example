# Copy to .env for local development
DATABASE_URL=postgres://planner:planner@localhost:5432/planner
PORT=3000

# Public URL of the web app, used in emails and links. Session cookies are marked
# Secure only when this is https://, so set it to the real address in production.
APP_URL=http://localhost:5173

# Email. Without RESEND_API_KEY emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=Planner <noreply@example.com>

# 32 random bytes, base64. Encrypts store credentials at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Where uploaded files are kept (default: ./data/storage in the repo)
STORAGE_DIR=
