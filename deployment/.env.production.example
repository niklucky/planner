# Copy to deployment/.env.production and fill in. Upload with: deployment/github-env.sh production
# Lines ending in "# public" become GitHub environment *variables*; everything else becomes a *secret*.

# Where the deploy job connects. The private key is read from deployment/keys/github.
SSH_HOST=1.2.3.4                                    # public

# Public URL. Cookies are marked Secure only for https://, and emails link here.
APP_URL=https://planner.spectron.dev                 # public
PORT=3000                                           # public

# Bind mounts on the VPS (created by provision.sh)
DB_DIR=/data/planner/db                             # public
MEDIA_DIR=/data/planner/media                       # public

# Secrets
POSTGRES_PASSWORD=change-me
ENCRYPTION_KEY=change-me-openssl-rand-base64-32
RESEND_API_KEY=
EMAIL_FROM=Planner <noreply@spectron.dev>            # public
